# Copy to secrets.toml for a free PUBLIC demo on Streamlit Community Cloud,
# where Ollama cannot run. Locally you don't need this file at all.
#
# Streamlit maps [secrets] entries to environment variables automatically.

CC_PROVIDER = "hosted"
# Groq (free tier) — get a key at https://console.groq.com
CC_HOSTED_BASE_URL = "https://api.groq.com/openai/v1"
CC_HOSTED_API_KEY  = "gsk_your_free_groq_key_here"
CC_HOSTED_CHAT_MODEL = "llama-3.3-70b-versatile"

# Voice features rely on local audio + Whisper; disable on cloud.
CC_ENABLE_VOICE = "0"
