# Copy to secrets.toml if you deploy to Streamlit Community Cloud and want a
# pre-configured default API key so visitors don't need their own.
# Streamlit maps [secrets] entries to environment variables automatically.
#
# OpenRouter (recommended — free models with high limits, 200+ to choose from):
#   Get a key at https://openrouter.ai/keys
#   Free models: google/gemini-2.0-flash-001, meta-llama/llama-3.3-70b-instruct:free

CC_PROVIDER = "hosted"
CC_HOSTED_BASE_URL = "https://openrouter.ai/api/v1"
CC_HOSTED_API_KEY = "sk-or-v1-your_openrouter_key_here"
CC_HOSTED_CHAT_MODEL = "google/gemini-2.0-flash-001"
CC_MAX_TOKENS = "4096"

# Voice requires local Whisper — disable on cloud.
CC_ENABLE_VOICE = "0"
