# Copy to secrets.toml for a free PUBLIC demo on Streamlit Community Cloud.
# Streamlit maps [secrets] entries to environment variables automatically.
#
# DeepSeek API (recommended — strong model, generous free credits):
#   Get a key at https://platform.deepseek.com → API Keys

CC_PROVIDER = "hosted"
CC_HOSTED_BASE_URL = "https://api.deepseek.com/v1"
CC_HOSTED_API_KEY = "sk-your_deepseek_key_here"
CC_HOSTED_CHAT_MODEL = "deepseek-chat"

# Voice requires local Whisper — disable on cloud.
CC_ENABLE_VOICE = "0"
