# ==========================================================================
# ZeroCode Career Coach — copy to .env and fill in your values
# ==========================================================================
#
# TWO WAYS TO RUN (pick one):
#
# 1. LOCAL OLLAMA (default — free, private, no keys needed):
#    $env:CC_PROVIDER = "ollama"   # Windows PowerShell
#    Just install Ollama and pull a model. That's it.
#
# 2. HOSTED API (no Ollama install — use a free cloud model):
#    Copy this file to .env, uncomment the HOSTED section below,
#    and paste your free API key from one of:
#
#    DeepSeek:    https://platform.deepseek.com   (recommended — generous free credits)
#    Groq:        https://console.groq.com/keys
#    OpenRouter:  https://openrouter.ai/keys
#
#    Then run:  streamlit run app.py
# ==========================================================================

# --------------------------------------------------------------------------
# Option A: LOCAL OLLAMA (default — comment out this whole section to use it)
# --------------------------------------------------------------------------
# CC_PROVIDER = "ollama"
# CC_OLLAMA_HOST = "http://localhost:11434"
# CC_CHAT_MODEL = "qwen3:14b-q4_K_M"
# CC_EMBED_MODEL = "nomic-embed-text"

# --------------------------------------------------------------------------
# Option B: HOSTED API (uncomment + add your key — no Ollama required!)
# --------------------------------------------------------------------------
CC_PROVIDER = "hosted"

CC_HOSTED_BASE_URL = "https://api.deepseek.com/v1"
CC_HOSTED_API_KEY = "sk-your_deepseek_key_here"    # ← REPLACE ME
CC_HOSTED_CHAT_MODEL = "deepseek-chat"

# Voice requires local Whisper — disable on cloud hosts.
CC_ENABLE_VOICE = "0"

# --------------------------------------------------------------------------
# Common options (optional)
# --------------------------------------------------------------------------
# CC_TEMPERATURE = "0.4"
# CC_TIMEOUT = "180"
